# ==================================================
# R ENVIRONMENT
# ==================================================
.RData
.Rhistory
.Rproj.user/

# ==================================================
# OS / SYSTEM FILES
# ==================================================
.DS_Store
Thumbs.db
desktop.ini

# ==================================================
# DATABASE (REBUILDABLE)
# ==================================================
database/*.sqlite*
*.sqlite*

# ==================================================
# RAW DATA (NEVER COMMIT)
# ==================================================
data/raw/
docs/data/raw/
website/data/raw/
website/data_files/

# Excel + temp artifacts
*.xlsx
*.xls
~$*

# ==================================================
# PROCESSED / GENERATED DATA
# ==================================================
data/processed/
docs/data/processed/
website/data/processed/

output/
# NOTE (2026-09-06): a bare "results_files/" rule used to live here and
# was accidentally matching docs/results_files/ and website/results_files/
# too (gitignore patterns with no leading slash match at any depth) --
# that's the knitr figure-output folder results.Rmd's plots render into,
# so its PNGs (e.g. the temperature-boxplot chart) were silently never
# committed and appeared broken on the live GitHub Pages site. Removed;
# no other "results_files" directory exists anywhere in this repo.
qc_reports/

# ==================================================
# GIS / LARGE FILES
# ==================================================
*.gpkg
*.shp
*.dbf
*.shx
*.geojson
*.zip

# ==================================================
# PHREEQC OUTPUTS
# ==================================================
phreeqc/runs/
phreeqc/outputs/

# ==================================================
# MODEL ARTIFACTS (REBUILDABLE; keep MODEL_REGISTRY.csv)
# ==================================================
models/**/*.rds
!models/MODEL_REGISTRY.csv

# ==================================================
# RENDERED NOTEBOOKS
# ==================================================
notebooks/_freeze/
notebooks/*.html
notebooks/*_cache/
notebooks/*_files/

# ==================================================
# OPTIONAL: TEMP DOC FILES
# ==================================================
~$*
*.tmp

# tesseract OCR cache (redirected into project to work around sandbox restriction -- see parse_well_log_pdf.R)
.tesseract_cache/

# ==================================================
# LITERATURE PDFs (NEVER COMMIT)
# ==================================================
# Matches the citation-not-rehosting policy stated on website/references.Rmd:
# this repo cites sources, it doesn't re-host their copyrighted PDFs. Also
# just very large (400+ MB, including full-resolution 1960s-era USGS plate
# scans) -- keep these local-only. build_website()'s docs/literature
# backup/restore guard (see scripts/run_pipeline.R) protects this folder
# across renders regardless of whether it's tracked in git.
docs/literature/
